  m_Script: {fileID: 11500000, guid: 7db0df5408222c448ba882eb111f0f1e, type: 3}
  m_Name: SocialHearMore03
  m_EditorClassIdentifier: 
  hearMoreName: SocialHearMore03
  hearMoreText: "The way software interacts with users can shape their well-being.
    Constant alerts, attention-grabbing colors, or endless scrolling can create stress
    and dependency, while thoughtful pacing, calm visuals, and clear user control
    promote focus and balance. Socially sustainable design means building systems
    that respect human attention \u2014 helping users feel empowered, not manipulated."
